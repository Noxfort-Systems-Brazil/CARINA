# CARINA - Controlled Artificial Road-traffic Intelligence Network Architecture
# Environment Secrets & Overrides Template (Twelve-Factor App)
# Copy this file to .env and configure your local environment.
# DO NOT commit your real .env file to Git!

CARINA_ENV=development
CARINA_SUPERUSER_USER=superuser_noxfort
CARINA_SUPERUSER_HASH=

# PostgreSQL Database Configuration
CARINA_DB_USER=user_carina
CARINA_DB_PASSWORD=your_database_password
CARINA_DB_HOST=localhost
CARINA_DB_PORT=5432
CARINA_DB_NAME=carina_data
CARINA_DB_SCHEMA=schema_carina

# SNMP Community
CARINA_SNMP_COMMUNITY=public

# Noxfort External Monitor Integration
# For local brokers: 127.0.0.1 or hostname:port
# For remote/cloud/ngrok: https://your-subdomain.ngrok-free.dev/api/telemetry
CARINA_MQTT_HOST=127.0.0.1
CARINA_MQTT_PORT=1883
CARINA_MQTT_USER=
CARINA_MQTT_PASSWORD=
