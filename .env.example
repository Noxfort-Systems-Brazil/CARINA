# ============================================================
# CARINA CORE - Environment Variables (12-Factor App)
# ============================================================
# Cópia deste arquivo deve ser renomeada para '.env' na máquina local.
# O arquivo '.env' não deve ser comitado no controle de versão (Git).

# --- Ambiente de Execução ---
# 'development': modo de teste/demonstração. Permite 'admin:admin'.
# 'production': modo de produção. BLOQUEIA ESTRITAMENTE 'admin:admin' e exige credenciais reais.
CARINA_ENV=development

# --- Super Usuário / Master Security Secrets ---
# Descomente e configure para definir o Super Usuário em produção.
# Em modo de produção, se nenhuma credencial for definida, 'admin:admin' permanece bloqueado.
# CARINA_SUPERUSER_USER=admin
# CARINA_SUPERUSER_PASSWORD=sua_senha_super_secreta_aqui
# CARINA_SUPERUSER_HASH=hash_sha256_da_senha

# --- Database Secrets ---
# Senhas e credenciais do banco de dados (ex: PostgreSQL)
CARINA_DB_USER=admin
CARINA_DB_PASSWORD=admin
CARINA_DB_HOST=localhost
CARINA_DB_PORT=5432
CARINA_DB_NAME=carina_data
CARINA_DB_SCHEMA=schema_carina

# --- SNMP / Hardware Secrets ---
# Chave de leitura/escrita para controladores semafóricos (NTCIP/UTMC)
CARINA_SNMP_COMMUNITY=public

# --- MQTT / Cloud Secrets ---
# Credenciais para exportar dados ou monitoramento externo
CARINA_MQTT_HOST=127.0.0.1
CARINA_MQTT_PORT=1883
CARINA_MQTT_USER=
CARINA_MQTT_PASSWORD=
