# CARINA Core - Configuração de Variáveis de Ambiente e Acesso Remoto (Tailscale Funnel)
# O acesso remoto ao CCO e às viaturas é gerenciado via Tailscale Funnel na porta 2201.
# IMPORTANTE: Em produção, mantenha CARINA_GATEWAY_ENABLED=False até configurar os tokens de autenticação abaixo.

CARINA_GATEWAY_ENABLED=False
CARINA_EVP_AUTH_TOKEN=
CARINA_CCO_AUTH_TOKEN=
CARINA_CCO_ALLOWED_ORIGIN=
CARINA_GATEWAY_TLS_CERT=
CARINA_GATEWAY_TLS_KEY=

# Segurança do Link gRPC com o Synapse (:50051)
CARINA_GRPC_AUTH_TOKEN=
CARINA_GRPC_TLS_ENABLED=False
CARINA_GRPC_TLS_CERT=
CARINA_GRPC_TLS_KEY=
CARINA_GRPC_TLS_CA=
CARINA_GRPC_REQUIRE_CLIENT_CERT=False

CARINA_DB_TYPE=sqlite
CARINA_DB_HOST=localhost
CARINA_DB_PORT=5432
CARINA_DB_USER=admin
CARINA_DB_PASSWORD=admin
CARINA_DB_NAME=carina_data
CARINA_DB_CONNECTED=False
CARINA_MONITOR_ENABLED=False
CARINA_MQTT_HOST=localhost
CARINA_MQTT_PORT=1883

# Segurança e Criptografia (PostgreSQL & SQLite)
# CARINA_SECRET_KEY deve ser uma chave Fernet Base64 segura (gerada via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CARINA_SECRET_KEY=
# Backend de Usuários: auto | sql | json
CARINA_USER_STORAGE=auto
