# syntax=docker/dockerfile:1
# CARINA Hermetic Package Builder (Debian/Ubuntu .deb)
# SPDX-FileCopyrightText: 2026 Noxfort Systems
# SPDX-License-Identifier: AGPL-3.0-or-later

# ==============================================================================
# Stage 1: Compile CCO Web Map Frontend (React / Vite)
# ==============================================================================
FROM node:20-bookworm-slim AS builder-cco

WORKDIR /app/src_tsx

# Cache package dependencies
COPY src_tsx/package.json src_tsx/package-lock.json* ./
RUN npm ci --prefer-offline || npm install

# Build static bundle
COPY src_tsx/ ./
RUN npm run build

# ==============================================================================
# Stage 2: Compile Go Hardware & Web Gateway (carina-go)
# ==============================================================================
FROM golang:1.24-alpine AS builder-go

WORKDIR /app/src_go

COPY src_go/go.mod src_go/go.sum* ./
RUN go mod download || true

COPY src_go/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/carina-go ./cmd/gateway

# ==============================================================================
# Stage 3: Build Isolated Python 3.12 Runtime & Wheels (/opt/carina/venv)
# ==============================================================================
FROM ubuntu:24.04 AS builder-python

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    CC=clang \
    CXX=clang++

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    clang \
    llvm \
    build-essential \
    gcc \
    g++ \
    cmake \
    pkg-config \
    libmpv-dev \
    libcairo2-dev \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

# Install standalone relocatable CPython 3.12 directly into /opt/carina/venv
RUN mkdir -p /opt/carina/venv && \
    curl -sSL "https://github.com/astral-sh/python-build-standalone/releases/download/20261021/cpython-3.12.15%2B20261021-x86_64-unknown-linux-gnu-install_only.tar.gz" \
    | tar -xz -C /opt/carina/venv --strip-components=1

# Install uv for ultra-fast, robust package installation into the standalone Python
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY requirements.txt /tmp/requirements.txt
RUN /bin/uv pip install --python /opt/carina/venv/bin/python3 -r /tmp/requirements.txt

# ==============================================================================
# Stage 4: Assemble Debian Package Root Tree
# ==============================================================================
FROM ubuntu:24.04 AS packager

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    dpkg \
    dpkg-dev \
    binutils \
    tar \
    gzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /package-root

# 1. Copy Debian metadata, launchers and systemd unit files
COPY packaging/deb/ /package-root/

# 2. Copy compiled Go Gateway
COPY --from=builder-go /app/bin/carina-go /package-root/opt/carina/bin/carina-go

# 3. Copy compiled CCO Frontend
COPY --from=builder-cco /app/src_tsx/dist/ /package-root/opt/carina/ui/dist/

# 4. Copy isolated Python venv
COPY --from=builder-python /opt/carina/venv/ /package-root/opt/carina/venv/

# 5. Copy CARINA application source code
COPY src/ /package-root/opt/carina/src/
COPY config/ /package-root/opt/carina/config/
COPY proto/ /package-root/opt/carina/proto/
COPY migrations/ /package-root/opt/carina/migrations/
COPY alembic.ini /package-root/opt/carina/alembic.ini
COPY carina.py /package-root/opt/carina/carina.py
COPY Model_Vault/ /package-root/opt/carina/Model_Vault/

# 6. Apply strict UNIX permissions
RUN chmod 755 /package-root/DEBIAN/postinst \
              /package-root/DEBIAN/prerm \
              /package-root/DEBIAN/postrm \
              /package-root/usr/bin/carina \
              /package-root/opt/carina/bin/carina-go && \
    chmod -R 755 /package-root/opt/carina/venv/bin && \
    chmod 644 /package-root/DEBIAN/control \
              /package-root/usr/share/applications/carina.desktop \
              /package-root/lib/systemd/system/carina.service

# 7. Compute Installed-Size and package into .deb
RUN SIZE=$(du -sk /package-root/opt /package-root/usr /package-root/lib 2>/dev/null | awk '{s+=$1} END {print s}') && \
    echo "Installed-Size: $SIZE" >> /package-root/DEBIAN/control && \
    mkdir -p /dist && \
    dpkg-deb --build --root-owner-group /package-root /dist/carina_1.0.0_amd64.deb

# ==============================================================================
# Stage 5: Export Artifact
# ==============================================================================
FROM scratch AS export
COPY --from=packager /dist/carina_1.0.0_amd64.deb /
